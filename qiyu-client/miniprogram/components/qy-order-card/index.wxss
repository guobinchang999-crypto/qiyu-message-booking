@import "../../styles/utilities.wxss";
.order-card{margin-bottom:24rpx;padding:28rpx;background:var(--qy-color-surface);border:1px solid var(--qy-color-border);border-radius:var(--qy-radius-md)}
.order-top{display:flex;justify-content:space-between;align-items:center;gap:20rpx}
.order-info{display:flex;gap:20rpx;margin:24rpx 0}
.order-thumb{width:120rpx;height:96rpx;flex-shrink:0}
.order-main{display:flex;flex:1;flex-direction:column;gap:10rpx;min-width:0}
.order-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:16rpx;padding-top:20rpx;border-top:1px solid var(--qy-color-divider);color:var(--qy-color-brand);font-size:24rpx}
.order-actions text{padding:10rpx 18rpx;border:1px solid var(--qy-color-border);border-radius:999rpx;background:var(--qy-color-surface)}
