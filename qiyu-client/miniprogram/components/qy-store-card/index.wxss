@import "../../styles/utilities.wxss";
.store-card{display:flex;align-items:center;gap:20rpx;box-sizing:border-box}
.store-card--list,.store-card--frequent{background:var(--qy-color-surface);border:1px solid var(--qy-color-border);border-radius:var(--qy-radius-md)}
.store-card--list{margin-bottom:24rpx;padding:24rpx}
.store-card--frequent{padding:20rpx}
.store-card--nearby{gap:18rpx;padding:20rpx 0;border-bottom:1px solid var(--qy-color-divider)}
.store-cover{width:132rpx;height:132rpx;flex-shrink:0}
.store-info{flex:1;display:flex;flex-direction:column;gap:9rpx;min-width:0}
.store-title{display:flex;align-items:center;justify-content:space-between;gap:12rpx;font-size:30rpx;font-weight:500}
.store-name{display:block;font-size:30rpx;font-weight:500;color:var(--qy-color-text)}
.address{font-size:26rpx;color:var(--qy-color-text)}
.next{color:var(--qy-color-brand);font-size:24rpx}
.nearby-icon{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;flex-shrink:0;border-radius:50%;background:var(--qy-color-brand-light);color:var(--qy-color-brand);font-family:"Songti SC"}
.status{font-size:22rpx;color:var(--qy-color-success)}
.tags{display:flex;flex-wrap:wrap;gap:10rpx}
.tags text{padding:6rpx 12rpx;border-radius:8rpx;background:var(--qy-color-brand-light);color:var(--qy-color-brand);font-size:22rpx}
.arrow{color:var(--qy-color-text-tertiary);font-size:40rpx}
