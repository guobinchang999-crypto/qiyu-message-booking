.qy-page { min-height: 100vh; box-sizing: border-box; padding-bottom: calc(152rpx + env(safe-area-inset-bottom)); }
.qy-section { margin: 48rpx 32rpx 0; }
.qy-section-title { display:flex; justify-content:space-between; align-items:center; margin-bottom:24rpx; font-family:"Songti SC", "STSong", serif; font-size:34rpx; font-weight:500; }
.qy-card { background:var(--qy-color-surface); border:1px solid var(--qy-color-border); border-radius:var(--qy-radius-md); box-sizing:border-box; }
.qy-muted { color:var(--qy-color-text-secondary); font-size:26rpx; }
.qy-caption { color:var(--qy-color-text-secondary); font-size:24rpx; }
.qy-primary-button { background:var(--qy-color-brand); color:#fff; border-radius:16rpx; font-size:30rpx; font-weight:500; }
.qy-bottom-action { position:fixed; z-index:200; left:0; right:0; bottom:0; box-sizing:border-box; padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background:var(--qy-color-surface); box-shadow:0 -8rpx 24rpx rgba(48,42,35,.06); }
.qy-status { display:inline-flex; align-items:center; padding:8rpx 14rpx; border-radius:8rpx; font-size:22rpx; }
.qy-status--upcoming { color:var(--qy-color-brand); background:var(--qy-color-brand-light); }
.qy-status--pending { color:var(--qy-color-warning); background:#F8EDE1; }
.qy-status--completed { color:var(--qy-color-success); background:#E7F0E8; }
.qy-status--cancelled { color:var(--qy-color-error); background:#F7E7E5; }
