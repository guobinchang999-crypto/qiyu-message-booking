 0;border-bottom:1px solid #E6DFD7}.review-summary{display:flex;flex-direction:column;gap:12rpx;padding:28rpx;font-size:28rpx}.review-list{display:flex;flex-direction:column;gap:18rpx}.review-item{display:flex;flex-direction:column;gap:12rpx;padding:22rpx 0;border-top:1px solid #E6DFD7;font-size:26rpx;line-height:1.55}.review-item>view:first-child{display:flex;justify-content:space-between;gap:20rpx}.review-tags{display:flex;flex-wrap:wrap;gap:10rpx}.review-tags text{padding:6rpx 12rpx;border-radius:8rpx;background:#E7ECE5;color:#3B533E;font-size:22rpx}.review-more{margin:6rpx 0 0;padding:0;border:1px solid #D7D0C8;border-radius:12rpx;background:#FBF8F5;color:#3B533E;font-size:24rpx;line-height:72rpx}.review-more::after{border:0}
