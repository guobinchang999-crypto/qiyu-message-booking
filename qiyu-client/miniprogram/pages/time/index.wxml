<view class="qy-page"><qy-navbar title="{{stateCopy.pageTitle}}" /><view class="summary" wx:if="{{confirmation}}"><text>{{confirmation.store.name}}</text><text>{{confirmation.service.name}} · {{confirmation.therapistDisplayName}} · {{confirmation.service.durationMinutes}}{{confirmation.cardMeta.durationUnit}}</text></view><view wx:if="{{loading}}" class="qy-section qy-card state-card"><qy-status-view type="loading" title="{{stateCopy.loadingTitle}}" description="{{stateCopy.loadingDescription}}" /></view><view wx:elif="{{error}}" class="qy-section qy-card state-card"><qy-status-view type="error" title="{{stateCopy.errorTitle}}" description="{{error}}" action-text="{{stateCopy.retryText}}" bind:retry="loadTimeSlots" /></view><block wx:else><scroll-view scroll-x class="date-scroll"><view class="date-item {{selectedDateIndex === index ? 'selected' : ''}}" wx:for="{{dates}}" wx:key="*this" data-index="{{index}}" bindtap="chooseDate">{{item}}</view></scroll-view><view class="period-tabs"><text wx:for="{{periods}}" wx:key="key" class="{{period === item.key ? 'active' : ''}}" data-period="{{item.key}}" bindtap="choosePeriod">{{item.label}}</text></view><view class="notice">{{stateCopy.noticeText}}</view><view wx:if="{{visibleSlots.length === 0 || !selectedSlotId}}" class="qy-section qy-card state-card"><qy-status-view type="empty" title="{{stateCopy.emptyTitle}}" description="{{stateCopy.emptyDescription}}" /><view class="empty-actions"><text bindtap="changeDate">{{stateCopy.emptyActionDateText}}</text><text bindtap="changeTherapist">{{stateCopy.emptyActionTherapistText}}</text></view></view><view wx:else class="slots"><view class="slot {{item.status}} {{selectedSlotId === item.id ? 'selected' : ''}}" wx:for="{{visibleSlots}}" wx:key="id" data-slot="{{item}}" bindtap="chooseSlot"><text>{{item.startAt}}</text><text>{{item.statusText}}</text></view></view><view class="legend"><text wx:for="{{legend}}" wx:key="status">□ {{item.label}}</text></view><view class="bottom-summary"><text>{{stateCopy.selectedSummaryTitle}}</text><text>{{selectedDateText}} · {{periodText}} · {{selectedSlotText}}</text></view></block><qy-bottom-action primary-text="{{stateCopy.nextButtonText}}" disabled="{{loading || !!error || !selectedSlotId}}" bind:primary="next" /></view>
