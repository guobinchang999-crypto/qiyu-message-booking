@import "../../styles/utilities.wxss";.qy-page{padding-bottom:calc(260rpx + env(safe-area-inset-bottom))}.summary{display:flex;flex-direction:column;gap:10rpx;margin:24rpx 32rpx 0;padding:24rpx;background:#FBF8F5;border:1px solid #D7D0C8;border-radius:16rpx;font-size:28rpx}.summary text:last-child{color:#666A66;font-size:24rpx}.state-card{padding:24rpx}.date-scroll{white-space:nowrap;margin-top:32rpx}.date-item{display:inline-flex;align-items:center;justify-content:center;white-space:pre-line;box-sizing:border-box;width:140rpx;height:100rpx;margin-left:20rpx;border:1px solid #D7D0C8;border-radius:12rpx;text-align:center;color:#666A66;font-size:24rpx}.date-item:first-child{margin-left:32rpx}.date-item.selected{background:#3B533E;border-color:#3B533E;color:#fff}.period-tabs{display:flex;gap:56rpx;margin:34rpx 32rpx 0;border-bottom:1px solid #D7D0C8}.period-tabs text{padding:0 8rpx 20rpx;color:#666A66;font-size:28rpx}.period-tabs .active{border-bottom:4rpx solid #3B533E;color:#3B533E}.notice{margin:24rpx 32rpx;padding:18rpx;background:#F2E9DD;color:#705431;border-radius:12rpx;font-size:24rpx}.slots{display:grid;grid-template-columns:repeat(4,1fr);gap:18rpx;margin:0 32rpx}.slot{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;height:96rpx;border:1px solid #3B533E;border-radius:12rpx;color:#3B533E;font-size:26rpx}.slot text:last-child{font-size:20rpx}.slot.limited{border-color:#B7793E;color:#B7793E}.slot.full{border-color:#EEECE8;background:#EEECE8;color:#9A9B97}.slot.selected{background:#3B533E;color:#fff}.legend{display:flex;gap:24rpx;margin:28rpx 32rpx;color:#666A66;font-size:20rpx}.empty-actions{display:flex;justify-content:center;gap:24rpx;margin-top:20rpx;color:#3B533E;font-size:24rpx}.empty-actions text{padding:10rpx 18rpx;border:1px solid #D7D0C8;border-radius:999rpx}.bottom-summary{position:fixed;z-index:190;left:0;right:0;bottom:calc(136rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:6rpx;padding:18rpx 32rpx;background:#F4F0EC;border-top:1px solid #E6DFD7;color:#666A66;font-size:22rpx}.bottom-summary text:last-child{color:#20231F;font-size:26rpx}
