@import "../../styles/utilities.wxss";
.stores-header{display:flex;align-items:center;gap:24rpx;padding:104rpx 32rpx 24rpx;font-family:"Songti SC";font-size:40rpx}.back{width:64rpx;color:#3B533E;font-family:-apple-system;font-size:56rpx}.search-bar{display:flex;align-items:center;gap:16rpx;margin:0 32rpx;padding:14rpx 16rpx;background:#FBF8F5;border:1px solid #D7D0C8;border-radius:16rpx}.search-bar input{flex:1;font-size:28rpx}.filter{padding:12rpx 20rpx;border-radius:999rpx;background:#EEECE8;color:#666A66;font-size:24rpx}.filter.active{background:#E7ECE5;color:#3B533E}.sort-tabs,.location-tools{display:flex;gap:14rpx;margin:20rpx 32rpx 0;overflow:hidden}.sort-tabs text,.location-tools text{padding:12rpx 18rpx;border:1px solid #D7D0C8;border-radius:999rpx;background:#FBF8F5;color:#666A66;font-size:24rpx}.sort-tabs .active,.location-tools .active{border-color:#3B533E;background:#E7ECE5;color:#3B533E}.map-entry{margin:24rpx 32rpx 0;padding:22rpx 24rpx;border:1px dashed #D7D0C8;border-radius:16rpx;color:#666A66;font-size:24rpx}.location-warning{margin:18rpx 32rpx 0;padding:18rpx 22rpx;border-radius:12rpx;background:#F8EDE1;color:#B7793E;font-size:24rpx}.state{display:flex;flex-direction:column;gap:20rpx;align-items:center}
.selected-location{margin:12rpx 32rpx 0;color:#3B533E;font-size:24rpx;line-height:1.45}
