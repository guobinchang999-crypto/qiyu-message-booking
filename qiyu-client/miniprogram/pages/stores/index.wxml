<view class="qy-page">
  <view class="stores-header">
    <text class="back" bindtap="back">‹</text>
    <text>{{stateCopy.pageTitle}}</text>
  </view>
  <view class="search-bar">
    <input placeholder="{{stateCopy.searchPlaceholder}}" value="{{keyword}}" bindinput="onSearch" />
    <text class="{{businessOnly ? 'filter active' : 'filter'}}" bindtap="toggleBusinessOnly">{{stateCopy.businessOnlyText}}</text>
  </view>
  <view class="sort-tabs">
    <text wx:for="{{sortOptions}}" wx:key="key" data-key="{{item.key}}" class="{{sortKey === item.key ? 'active' : ''}}" bindtap="chooseSort">{{item.label}}</text>
  </view>
  <view class="map-entry" bindtap="openMap">{{stateCopy.mapEntryText}}</view>
  <view wx:if="{{selectedLocationText}}" class="selected-location">{{selectedLocationText}}</view>
  <view class="location-tools">
    <text class="{{locationStatus === 'ready' ? 'active' : ''}}">{{stateCopy.locationReadyText}}</text>
    <text bindtap="refreshLocation">{{stateCopy.locateActionText}}</text>
  </view>
  <view wx:if="{{locationStatus === 'denied'}}" class="location-warning">{{stateCopy.locationDeniedWarning}}</view>
  <view wx:if="{{locationStatus === 'failed'}}" class="location-warning">{{stateCopy.locationFailedWarning}}</view>
  <view wx:if="{{loading}}" class="qy-section qy-card"><qy-status-view type="loading" title="{{stateCopy.loadingTitle}}" description="{{stateCopy.loadingDescription}}" /></view>
  <view wx:elif="{{error}}" class="qy-section qy-card"><qy-status-view type="error" title="{{stateCopy.errorTitle}}" description="{{error}}" action-text="{{stateCopy.retryText}}" bind:retry="loadStores" /></view>
  <view wx:elif="{{visibleStores.length === 0}}" class="qy-section qy-card"><qy-status-view type="empty" title="{{stateCopy.emptyTitle}}" description="{{stateCopy.emptyDescription}}" /></view>
  <view wx:else class="qy-section">
    <qy-store-card wx:for="{{visibleStores}}" wx:key="id" store="{{item}}" meta-copy="{{storeCardMeta}}" bind:select="goStore" />
  </view>
</view>
