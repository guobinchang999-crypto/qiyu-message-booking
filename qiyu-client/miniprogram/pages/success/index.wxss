@import "../../styles/utilities.wxss";.success-page{min-height:100vh;padding:170rpx 32rpx calc(80rpx + env(safe-area-inset-bottom));box-sizing:border-box;text-align:center}.state-card{padding:32rpx;background:#FBF8F5;border:1px solid #D7D0C8;border-radius:16rpx}.success-icon{display:flex;align-items:center;justify-content:center;width:128rpx;height:128rpx;margin:auto;border-radius:50%;background:#E7ECE5;color:#3B533E;font-size:64rpx}.success-title{display:block;margin-top:32rpx;font-family:"Songti SC";font-size:46rpx}.booking-card{display:flex;flex-direction:column;gap:18rpx;margin-top:56rpx;padding:36rpx;text-align:left;background:#FBF8F5;border:1px solid #D7D0C8;border-radius:24rpx;font-size:28rpx}.code-hint{color:#666A66;font-size:24rpx;line-height:1.5}.store-actions{display:flex;justify-content:center;gap:24rpx;margin-top:24rpx}.store-actions text{padding:10rpx 20rpx;border:1px solid #D7D0C8;border-radius:999rpx;color:#3B533E;font-size:24rpx}.reminder{margin:32rpx 12rpx;color:#666A66;font-size:24rpx;line-height:1.6}.primary,.secondary{width:100%;height:96rpx;margin-top:20rpx;border-radius:16rpx;font-size:30rpx}.primary{background:#3B533E;color:#fff}.secondary{background:#FBF8F5;color:#3B533E;border:1px solid #3B533E}
