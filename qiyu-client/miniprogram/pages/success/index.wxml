<view class="success-page"><view wx:if="{{loading}}" class="state-card"><qy-status-view type="loading" title="{{stateCopy.loadingTitle}}" description="{{stateCopy.loadingDescription}}" /></view><view wx:elif="{{error}}" class="state-card"><qy-status-view type="error" title="{{stateCopy.errorTitle}}" description="{{error}}" action-text="{{stateCopy.retryText}}" bind:retry="loadBooking" /><button class="secondary" bindtap="home">{{copy.homeButtonText}}</button></view><block wx:elif="{{booking}}"><view class="success-icon">✓</view><text class="success-title">{{copy.title}}</text><text class="qy-muted">{{copy.subtitle}}</text><view class="booking-card"><text>{{booking.store.name}}</text><text>{{booking.service.name}} · {{booking.therapist.name}}</text><text>{{booking.scheduledAt}}</text><text class="qy-muted">{{copy.bookingCodePrefix}} {{booking.code}}</text><text class="code-hint">{{copy.codeHint}}</text></view><view class="store-actions"><text bindtap="navigateStore">{{copy.navigationActionText}}</text><text bindtap="contactStore">{{copy.contactActionText}}</text></view><view class="reminder">{{copy.reminderText}}</view><button class="primary" bindtap="detail">{{copy.detailButtonText}}</button><button class="secondary" bindtap="home">{{copy.homeButtonText}}</button></block></view>
