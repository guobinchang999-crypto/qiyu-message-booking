@import "../../styles/utilities.wxss";
.services-header{display:flex;align-items:center;justify-content:space-between;padding:112rpx 32rpx 24rpx;font-family:"Songti SC";font-size:42rpx}.store-switch{font-family:-apple-system;color:#3B533E;font-size:26rpx}.search-bar{display:flex;align-items:center;gap:16rpx;margin:0 32rpx;padding:18rpx 22rpx;background:#FBF8F5;border:1px solid #D7D0C8;border-radius:16rpx}.search-bar input{flex:1;font-size:28rpx}.clear-search{color:#3B533E;font-size:24rpx}.category-tabs{white-space:nowrap;margin-top:24rpx;padding-left:32rpx}.category-tabs text{display:inline-block;margin-right:16rpx;padding:14rpx 24rpx;border:1px solid #D7D0C8;border-radius:999rpx;background:#FBF8F5;color:#666A66;font-size:24rpx}.category-tabs .active,.sort-tabs .active{background:#E7ECE5;color:#3B533E;border-color:#3B533E}.sort-tabs{display:flex;gap:14rpx;margin:20rpx 32rpx 0}.sort-tabs text{padding:12rpx 18rpx;border:1px solid #D7D0C8;border-radius:999rpx;background:#FBF8F5;color:#666A66;font-size:24rpx}.service-banner{margin:24rpx 32rpx 0;padding:28rpx;border-radius:24rpx;background:#F2E9DD;color:#705431;font-size:26rpx}.state{display:flex;flex-direction:column;gap:20rpx;align-items:center}
