@import "../../styles/utilities.wxss";.profile-header{display:flex;justify-content:space-between;padding:112rpx 32rpx 32rpx;font-family:"Songti SC";font-size:42rpx}.state-card{padding:24rpx}.profile-user{display:flex;align-items:center;gap:22rpx;margin:0 32rpx}.avatar{display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;border-radius:50%;background:#CCD8C7;color:#3B533E;font-family:"Songti SC";font-size:40rpx}.profile-user view:last-child{display:flex;flex-direction:column;gap:8rpx;color:#666A66;font-size:24rpx}.name{color:#20231F;font-size:34rpx;font-weight:500}.level{color:#B28A57}.member{display:flex;flex-direction:column;gap:16rpx;margin:36rpx 32rpx 0;padding:32rpx;border-radius:24rpx;background:#F2E9DD;color:#705431;font-size:28rpx}.member>text:nth-child(2){font-size:22rpx}.member view{display:flex;justify-content:space-between;gap:12rpx;margin-top:14rpx;font-size:24rpx}.member view text{min-width:0}.shortcuts{display:flex;justify-content:space-around;padding:26rpx 0;background:#FBF8F5;border:1px solid #D7D0C8;border-radius:16rpx}.shortcuts view{display:flex;flex-direction:column;align-items:center;gap:10rpx;font-size:23rpx}.shortcuts view text:first-child{font-size:32rpx;color:#3B533E}.recent-booking{display:flex;flex-direction:column;gap:12rpx;padding:28rpx}.recent-booking>view{display:flex;justify-content:space-between;align-items:center;font-size:28rpx}.recent-link{color:#3B533E;font-size:24rpx}.menu{padding:0 28rpx}.menu view{display:flex;justify-content:space-between;align-items:center;min-height:100rpx;border-bottom:1px solid #E6DFD7;font-size:28rpx}.menu view text:last-child{color:#666A66}.logout{margin:44rpx 32rpx;width:calc(100% - 64rpx);background:#FBF8F5;border:1px solid #C25B52;border-radius:16rpx;color:#C25B52;font-size:28rpx}
