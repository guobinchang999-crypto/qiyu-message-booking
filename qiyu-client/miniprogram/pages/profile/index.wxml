<view class="qy-page"><view class="profile-header"><text>{{profile.title}}</text><text>{{profile.settingsIcon}}</text></view><view wx:if="{{loading}}" class="qy-section qy-card state-card"><qy-status-view type="loading" title="{{stateCopy.loadingTitle}}" description="{{stateCopy.loadingDescription}}" /></view><view wx:elif="{{error}}" class="qy-section qy-card state-card"><qy-status-view type="error" title="{{stateCopy.errorTitle}}" description="{{error}}" action-text="{{stateCopy.retryText}}" bind:retry="loadProfile" /></view><block wx:else><view class="profile-user"><view class="avatar">{{profile.user.avatarText}}</view><view><text class="name">{{profile.user.name}}</text><text>{{profile.user.phone}}</text><text class="level">{{profile.user.level}}</text></view></view><view class="member"><text>{{profile.memberTitle}}</text><text>{{profile.memberSubtitle}}</text><view><text wx:for="{{profile.memberStats}}" wx:key="*this">{{item}}</text></view></view><view class="qy-section shortcuts"><view wx:for="{{profile.shortcuts}}" wx:key="key" data-key="{{item.key}}" bindtap="onShortcut"><text>{{item.title}}</text><text>{{item.subtitle}}</text></view></view><view wx:if="{{recentBooking}}" class="qy-section qy-card recent-booking" bindtap="goRecentBooking"><view><text>{{profile.recentBookingTitle}}</text><text class="recent-link">{{profile.recentBookingActionText}}</text></view><text class="store-name">{{recentBooking.service.name}}</text><text class="qy-muted">{{recentBooking.store.name}} · {{recentBooking.scheduledAt}}</text></view><view class="qy-section qy-card menu"><view wx:for="{{profile.menuItems}}" wx:key="key" data-key="{{item.key}}" bindtap="onMenu"><text>{{item.label}}</text><text>{{item.valueText}}</text></view></view><button class="logout" bindtap="logout">{{profile.logoutText}}</button></block></view>
