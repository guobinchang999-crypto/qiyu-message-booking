<view class="qy-page"><qy-navbar title="{{dictionaries.detailTitle}}" /><view wx:if="{{loading}}" class="qy-section qy-card state-card"><qy-status-view type="loading" title="{{stateCopy.loadingTitle}}" description="{{stateCopy.loadingDescription}}" /></view><view wx:elif="{{error}}" class="qy-section qy-card state-card"><qy-status-view type="error" title="{{stateCopy.errorTitle}}" description="{{error}}" action-text="{{stateCopy.retryText}}" bind:retry="loadBooking" /></view><block wx:elif="{{booking}}"><view class="qy-section"><view class="status-card"><text class="qy-status qy-status--upcoming">{{statusText}}</text><view class="steps"><text wx:for="{{steps}}" wx:key="label" class="{{item.state}}">{{item.label}}</text></view></view></view><view class="qy-section code-card"><view class="qr"><image wx:if="{{booking.qrImageUrl && !qrImageLoadFailed}}" src="{{booking.qrImageUrl}}" mode="aspectFit" binderror="onQrImageError" /><text wx:else>{{dictionaries.codeTitle}}</text></view><text class="code">{{codeText}}</text><text class="qy-muted">{{dictionaries.codeHint}}，{{dictionaries.codeExtraHint}}</text></view><view class="qy-section qy-card info"><text class="store-name">{{booking.store.name}}</text><view wx:for="{{detailRows}}" wx:key="key"><text>{{item.label}}</text><text>{{item.value}}</text></view></view><view class="qy-section qy-card info payment"><text class="store-name">{{dictionaries.paymentTitle}}</text><view wx:for="{{paymentRows}}" wx:key="key"><text>{{item.label}}</text><text class="{{item.tone === 'discount' ? 'discount' : ''}}">{{item.value}}</text></view></view><view class="qy-section qy-card actions"><text class="store-name">{{dictionaries.actionSectionTitle}}</text><view><text wx:for="{{booking.availableActions}}" wx:key="*this" data-action="{{item}}" bindtap="handleAction">{{dictionaries.actionLabel[item]}}</text></view></view></block><qy-bottom-action primary-text="{{dictionaries.checkinButtonText}}" disabled="{{loading || !!error || acting || !booking || !canCheckin}}" bind:primary="checkin" /></view>
