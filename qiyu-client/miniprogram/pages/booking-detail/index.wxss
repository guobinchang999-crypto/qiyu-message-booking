@import "../../styles/utilities.wxss";.state-card{padding:24rpx}.status-card{padding:28rpx;background:#FBF8F5;border-radius:16rpx}.steps{display:flex;justify-content:space-between;margin-top:28rpx;color:#9A9B97;font-size:22rpx}.steps .done,.steps .active{color:#3B533E}.steps .active{font-weight:500}.code-card{display:flex;flex-direction:column;align-items:center;gap:18rpx;padding:44rpx;background:#FBF8F5;border:1px solid #D7D0C8;border-radius:24rpx}.qr{display:flex;align-items:center;justify-content:center;width:320rpx;height:320rpx;background:repeating-linear-gradient(45deg,#20231F 0 10rpx,#fff 10rpx 20rpx);color:#fff;text-align:center;font-size:28rpx;line-height:1.8}.qr image{width:260rpx;height:260rpx}.qr text{white-space:pre-line}.code{max-width:100%;font-size:44rpx;line-height:1.35;text-align:center;word-break:break-all}.info{display:flex;flex-direction:column;gap:20rpx;padding:28rpx}.info view{display:flex;justify-content:space-between;gap:24rpx;font-size:26rpx}.info view text:first-child{color:#666A66;white-space:nowrap}.info view text:last-child{text-align:right}.payment .discount{color:#3F6B4F}.actions{display:flex;flex-direction:column;gap:20rpx;padding:28rpx}.actions view{display:flex;flex-wrap:wrap;gap:16rpx}.actions view text{padding:10rpx 18rpx;border:1px solid #D7D0C8;border-radius:999rpx;color:#3B533E;font-size:24rpx}
