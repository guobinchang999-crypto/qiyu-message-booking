@import "../../styles/utilities.wxss";.info-card,.form-card,.payment{display:flex;flex-direction:column;gap:18rpx;padding:28rpx}.inline-error{padding:24rpx}.summary-row{display:flex;justify-content:space-between;gap:24rpx;align-items:center;font-size:28rpx}.summary-row text:first-child{min-width:0}.summary-row text:last-child{flex-shrink:0;color:#3B533E;font-size:24rpx}.form-row,.payment view{display:flex;justify-content:space-between;align-items:center;min-height:70rpx;border-bottom:1px solid #E6DFD7;font-size:28rpx}.input-row input{flex:1;margin-left:40rpx;text-align:right;font-size:28rpx}.guest-stepper{display:flex;align-items:center;gap:18rpx}.stepper{min-width:36rpx;text-align:center}.stepper-button{display:flex;align-items:center;justify-content:center;width:64rpx;height:64rpx;margin:0;padding:0;border:1px solid #3B533E;border-radius:50%;background:#FBF8F5;color:#3B533E;font-size:34rpx;line-height:64rpx}.stepper-button[disabled],.stepper-button.disabled{border-color:#D7D0C8;background:#EEECE8;color:#9A9B97}.benefit-row{display:flex;justify-content:space-between;padding:24rpx;background:#F2E9DD;color:#705431;border-radius:12rpx;font-size:24rpx}.discount{color:#3F6B4F}.payment.refreshing{opacity:.62}.payment .total{padding-top:16rpx;border:0;font-weight:500}.total text:last-child{color:#B28A57;font-size:38rpx}.agreement{display:flex;gap:14rpx;align-items:center;margin:28rpx 32rpx;color:#666A66;font-size:22rpx}.agreement.disabled{opacity:.55}.check{width:28rpx;height:28rpx;border:1px solid #9A9B97;border-radius:50%;text-align:center;line-height:28rpx}.checked{background:#3B533E;color:#fff;border-color:#3B533E}
