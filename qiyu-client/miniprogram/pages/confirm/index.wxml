<view class="qy-page"><qy-navbar title="{{confirmation ? confirmation.pageTitle : ''}}" /><view wx:if="{{loading}}" class="qy-section qy-card inline-error"><qy-status-view type="loading" title="{{stateCopy.loadingTitle}}" description="{{stateCopy.loadingDescription}}" /></view><view wx:elif="{{error && !confirmation}}" class="qy-section qy-card inline-error"><qy-status-view type="error" title="{{stateCopy.errorTitle}}" description="{{error}}" action-text="{{stateCopy.retryText}}" bind:retry="loadConfirmation" /></view><block wx:elif="{{confirmation}}"><view class="qy-section"><view class="qy-card info-card"><view class="summary-row"><text class="store-name">{{confirmation.store.name}}</text><text bindtap="editStore">{{confirmation.editActions.store}}</text></view><view class="summary-row"><text class="qy-muted">{{confirmation.service.name}} · {{confirmation.service.durationMinutes}}{{confirmation.cardMeta.durationUnit}}</text><text bindtap="editService">{{confirmation.editActions.service}}</text></view><view class="summary-row"><text class="qy-muted">{{confirmation.therapistDisplayName}}</text><text bindtap="editTherapist">{{confirmation.editActions.therapist}}</text></view><view class="summary-row"><text class="qy-muted">{{confirmation.scheduledAt}}</text><text bindtap="editTime">{{confirmation.editActions.time}}</text></view></view></view><view wx:if="{{error}}" class="qy-section qy-card inline-error"><qy-status-view type="error" title="{{stateCopy.submitErrorTitle}}" description="{{error}}" /></view><view class="qy-section qy-card form-card"><view class="form-row"><text>{{confirmation.formCopy.guestCountLabel}}</text><view class="guest-stepper"><button class="stepper-button {{draft.guestCount <= 1 || submitting || refreshingPayment ? 'disabled' : ''}}" data-delta="{{-1}}" disabled="{{draft.guestCount <= 1 || submitting || refreshingPayment}}" bindtap="changeGuestCount">−</button><text class="stepper">{{draft.guestCount}}</text><button class="stepper-button {{draft.guestCount >= 4 || submitting || refreshingPayment ? 'disabled' : ''}}" data-delta="{{1}}" disabled="{{draft.guestCount >= 4 || submitting || refreshingPayment}}" bindtap="changeGuestCount">＋</button></view></view><view class="form-row input-row"><text>{{confirmation.formCopy.contactLabel}}</text><input value="{{draft.contact}}" disabled="{{submitting}}" bindinput="onNameInput" placeholder="{{confirmation.formCopy.contactPlaceholder}}"/></view><view class="form-row input-row"><text>{{confirmation.formCopy.remarkLabel}}</text><input value="{{draft.remark}}" disabled="{{submitting}}" bindinput="onRemarkInput" placeholder="{{confirmation.formCopy.remarkPlaceholder}}"/></view></view><view class="qy-section benefit-row"><text>{{confirmation.benefitTitle}}</text><text>{{confirmation.benefitSelectionText}}</text></view><view class="qy-section qy-card payment {{refreshingPayment ? 'refreshing' : ''}}"><text class="store-name">{{confirmation.paymentTitle}}</text><view wx:for="{{confirmation.paymentLines}}" wx:key="key"><text>{{item.label}}</text><text class="{{item.tone === 'discount' ? 'discount' : ''}}">{{item.amountText}}</text></view><view class="total"><text>{{confirmation.totalLabel}}</text><text>¥{{confirmation.payment.depositDue}}</text></view></view><view class="agreement {{submitting ? 'disabled' : ''}}" bindtap="onAgreement"><text class="check {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</text><text>{{confirmation.agreementText}}</text></view></block><qy-bottom-action primary-text="{{confirmation ? confirmation.depositButtonText : ''}}" loading="{{submitting || refreshingPayment}}" disabled="{{loading || refreshingPayment || !confirmation || !agreed || submitting}}" bind:primary="submit" /></view>
