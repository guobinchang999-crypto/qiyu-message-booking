<view class="login-page"><view class="login-hero"><view class="brand-mark">{{copy.brandMark}}</view><text class="brand-name">{{copy.brandName}}</text><text class="brand-subtitle">{{copy.brandSubtitle}}</text><text class="welcome">{{copy.welcomeText}}</text></view><view class="login-panel"><text class="panel-title">{{copy.panelTitle}}</text><view class="field"><text>{{copy.phoneLabel}}</text><input type="number" maxlength="11" value="{{phone}}" disabled="{{submitting}}" bindinput="onPhoneInput" placeholder="{{copy.phonePlaceholder}}"/><text class="field-error" wx:if="{{phoneError}}">{{phoneError}}</text></view><view class="field code-row"><view class="code-input"><text>{{copy.codeLabel}}</text><input type="number" maxlength="6" value="{{code}}" disabled="{{submitting}}" bindinput="onCodeInput" placeholder="{{copy.codePlaceholder}}"/><text class="field-error" wx:if="{{codeError}}">{{codeError}}</text></view><button class="code-link {{(submitting || sendingCode || countdown > 0) ? 'disabled' : ''}}" loading="{{sendingCode}}" disabled="{{submitting || sendingCode || countdown > 0}}" bindtap="sendCode">{{countdown > 0 ? countdown + 's' : copy.sendCodeText}}</button></view><button class="login-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onLogin">{{submitting ? copy.loggingInText : copy.loginButtonText}}</button><view class="agreement {{submitting ? 'disabled' : ''}}" bindtap="onAgreementChange"><text class="check {{agreed ? 'checked' : ''}}">{{agreed ? '✓' : ''}}</text><text>{{copy.agreementText}}</text></view><view class="wechat-entry">{{copy.wechatEntryText}}</view></view></view>
