@import "../../styles/tokens.wxss";.login-page{min-height:100vh;box-sizing:border-box;padding-bottom:calc(64rpx + env(safe-area-inset-bottom));background:#F4F0EC}.login-hero{box-sizing:border-box;height:470rpx;padding:112rpx 64rpx 0;background:linear-gradient(145deg,#3B533E,#6B7E65);color:#fff}.brand-mark{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;border:1px solid rgba(255,255,255,.65);border-radius:50%;font-family:"Songti SC";font-size:42rpx}.brand-name{display:block;margin-top:24rpx;font-family:"Songti SC";font-size:52rpx}.brand-subtitle,.welcome{display:block;margin-top:8rpx;font-size:24rpx;letter-spacing:5rpx;opacity:.85}.welcome{margin-top:40rpx;font-size:30rpx;letter-spacing:0}.login-panel{margin:-40rpx 32rpx 0;padding:48rpx 32rpx;background:#FBF8F5;border-radius:24rpx;box-shadow:0 16rpx 48rpx rgba(48,42,35,.12)}.panel-title{font-family:"Songti SC";font-size:40rpx}.field{position:relative;margin-top:36rpx;padding-bottom:18rpx;border-bottom:1px solid #D7D0C8;font-size:26rpx}.field input{height:58rpx;font-size:30rpx}.code-row{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx}.code-input{position:relative;flex:1;min-width:0}.code-link{align-self:flex-end;box-sizing:border-box;min-width:168rpx;height:64rpx;margin:26rpx 0 0;padding:0 20rpx;border:1px solid #3B533E;border-radius:12rpx;background:#FBF8F5;color:#3B533E;font-size:24rpx;line-height:62rpx}.code-link[disabled]{border-color:#D7D0C8;color:#9A9B97;background:#EEECE8}.disabled{opacity:.55}.field-error{position:absolute;bottom:-28rpx;color:#C25B52;font-size:20rpx}.login-button{margin-top:48rpx;background:#3B533E;color:#fff;border-radius:16rpx;font-size:30rpx}.agreement{display:flex;gap:14rpx;align-items:center;margin-top:28rpx;color:#666A66;font-size:22rpx}.check{width:28rpx;height:28rpx;border:1px solid #9A9B97;border-radius:50%;text-align:center;line-height:28rpx}.checked{background:#3B533E;color:#fff;border-color:#3B533E}.wechat-entry{text-align:center;margin-top:44rpx;color:#3B533E;font-size:26rpx}
