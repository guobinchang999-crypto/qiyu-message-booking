@import "../../styles/utilities.wxss";.checkin-page{min-height:100vh;box-sizing:border-box;padding-bottom:calc(180rpx + env(safe-area-inset-bottom))}.state-card{padding:24rpx}.booking-summary{display:flex;flex-direction:column;gap:12rpx;margin:0 32rpx;padding:28rpx;background:#FBF8F5;border:1px solid #D7D0C8;border-radius:16rpx;font-size:28rpx}.booking-summary text:not(:first-child){color:#666A66;font-size:24rpx}.code-area{display:flex;flex-direction:column;align-items:center;gap:20rpx;margin:48rpx 32rpx}.large-code{display:flex;align-items:center;justify-content:center;width:360rpx;height:360rpx;background:#20231F;color:#fff;text-align:center;line-height:1.8;font-size:30rpx;box-shadow:inset 0 0 0 28rpx #fff,0 0 0 1px #D7D0C8}.large-code image{width:300rpx;height:300rpx}.large-code text{white-space:pre-line}.numeric-code{max-width:100%;font-size:44rpx;line-height:1.35;text-align:center;word-break:break-all}.refresh-link{padding:10rpx 18rpx;border:1px solid #D7D0C8;border-radius:999rpx;color:#3B533E;font-size:24rpx}.progress{display:flex;justify-content:space-around;margin:0 32rpx;color:#9A9B97;font-size:22rpx}.progress .done,.progress .current{color:#3B533E}.checkin-bottom{position:fixed;left:0;right:0;bottom:0;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));background:#FBF8F5;box-shadow:0 -8rpx 24rpx rgba(48,42,35,.06)}.checkin-button{background:#3B533E;color:#fff;border-radius:16rpx;font-size:30rpx}.checkin-button[disabled]{background:#9A9B97;color:#fff}.checkin-bottom view{display:flex;justify-content:space-around;margin-top:20rpx;color:#3B533E;font-size:24rpx}
