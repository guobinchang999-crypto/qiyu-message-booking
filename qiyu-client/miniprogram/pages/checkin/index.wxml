<view class="checkin-page"><qy-navbar title="{{dictionaries.title}}" /><view wx:if="{{loading}}" class="qy-section qy-card state-card"><qy-status-view type="loading" title="{{stateCopy.loadingTitle}}" description="{{stateCopy.loadingDescription}}" /></view><view wx:elif="{{error && !booking}}" class="qy-section qy-card state-card"><qy-status-view type="error" title="{{stateCopy.errorTitle}}" description="{{error}}" action-text="{{stateCopy.retryText}}" bind:retry="loadBooking" /></view><block wx:elif="{{booking}}"><view wx:if="{{error}}" class="qy-section qy-card state-card"><qy-status-view type="error" title="{{stateCopy.submitErrorTitle}}" description="{{error}}" /></view><view class="booking-summary"><text>{{booking.store.name}}</text><text>{{booking.service.name}} · {{booking.therapist.name}}</text><text>{{booking.scheduledAt}}</text></view><view class="code-area"><view class="large-code"><image wx:if="{{booking.qrImageUrl && !qrImageLoadFailed}}" src="{{booking.qrImageUrl}}" mode="aspectFit" binderror="onQrImageError" /><text wx:else>{{dictionaries.qrTitle}}</text></view><text class="numeric-code">{{codeText}}</text><text class="qy-muted">{{refreshHint}}</text><text class="refresh-link" bindtap="refreshCode">{{stateCopy.refreshCodeText}}</text></view><view class="progress"><text wx:for="{{progressSteps}}" wx:key="label" class="{{item.state}}">{{index + 1}} {{item.label}}</text></view><view class="checkin-bottom"><button class="checkin-button" loading="{{checking}}" disabled="{{checking}}" bindtap="checkin">{{buttonText}}</button><view><text wx:for="{{dictionaries.bottomActions}}" wx:key="key" data-key="{{item.key}}" bindtap="handleBottomAction">{{item.label}}</text></view></view></block></view>
