<view class="qy-page"><view class="home-hero"><text class="location">{{copy.locationText}}</text><text class="hero-title">{{copy.heroTitle}}</text><view class="search" bindtap="goServices">{{copy.searchPlaceholder}}</view></view><view class="quick-actions"><block wx:for="{{quickActions}}" wx:key="key"><button wx:if="{{item.isSupport}}" class="quick-action" open-type="contact" binderror="onSupportContactError"><text>{{item.title}}</text><text>{{item.subtitle}}</text></button><view wx:else class="quick-action" data-key="{{item.key}}" bindtap="onQuickAction"><text>{{item.title}}</text><text>{{item.subtitle}}</text></view></block></view><view wx:if="{{loading}}" class="qy-section qy-card state-card"><qy-status-view type="loading" title="{{stateCopy.loadingTitle}}" description="{{stateCopy.loadingDescription}}" /></view><view wx:elif="{{error}}" class="qy-section qy-card state-card"><qy-status-view type="error" title="{{stateCopy.errorTitle}}" description="{{error}}" action-text="{{stateCopy.retryText}}" bind:retry="loadHome" /></view><block wx:else><view class="qy-section"><view class="qy-section-title"><text>{{copy.frequentTitle}}</text><text class="more" bindtap="goStores">{{copy.frequentMoreText}}</text></view><qy-store-card wx:for="{{frequentStores}}" wx:key="id" store="{{item}}" variant="frequent" meta-copy="{{copy.storeCardMeta}}" bind:select="goStore" /></view><view class="qy-section"><view class="qy-section-title"><text>{{copy.nearbyTitle}}</text><text class="more" bindtap="showDistanceSort">{{copy.nearbySortText}}</text></view><qy-store-card wx:for="{{nearbyStores}}" wx:key="id" store="{{item}}" variant="nearby" meta-copy="{{copy.storeCardMeta}}" bind:select="goStore" /></view><view class="qy-section"><view class="qy-section-title"><text>{{copy.featuredServiceTitle}}</text><text class="more" bindtap="goServices">{{copy.featuredServiceMoreText}}</text></view><view class="service-scroll"><qy-service-card wx:for="{{services}}" wx:key="id" service="{{item}}" variant="featured" meta-copy="{{copy.serviceCardMeta}}" bind:select="goService" /></view></view><view class="qy-section member-card" bindtap="goProfile"><text>{{copy.memberTitle}}</text><text>{{copy.memberSummary}}</text><text>{{copy.memberActionText}}</text></view></block></view>
