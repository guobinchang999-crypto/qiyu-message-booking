<view class="qy-page"><view class="orders-header"><text>{{dictionaries.pageTitle}}</text></view><scroll-view scroll-x class="order-tabs"><text wx:for="{{tabs}}" wx:key="key" class="{{tab===item.key?'active':''}}" data-tab="{{item.key}}" bindtap="chooseTab">{{item.label}}</text></scroll-view><view class="qy-section"><view wx:if="{{loading}}" class="qy-card empty"><qy-status-view type="loading" title="{{stateCopy.loadingTitle}}" description="{{stateCopy.loadingDescription}}" /></view><view wx:elif="{{error}}" class="qy-card empty"><qy-status-view type="error" title="{{stateCopy.errorTitle}}" description="{{error}}" action-text="{{stateCopy.retryText}}" bind:retry="loadOrders" /></view><view wx:elif="{{visibleBookings.length === 0}}" class="qy-card empty"><qy-status-view type="empty" title="{{stateCopy.emptyTitle}}" description="{{stateCopy.emptyDescription}}" /></view><qy-order-card wx:else wx:for="{{visibleBookings}}" wx:key="id" booking="{{item}}" dictionaries="{{dictionaries}}" meta-copy="{{dictionaries.cardMeta}}" bind:select="detail" bind:action="handleAction" /></view></view>
