@import "../../styles/utilities.wxss";
.state-card{padding:24rpx}.validation-error{box-sizing:border-box;padding:18rpx 22rpx;border-radius:12rpx;background:#F7E7E5;color:#C25B52;font-size:24rpx}.review-summary{padding:0 32rpx 8rpx;font-size:26rpx}.booking-summary{display:flex;flex-direction:column;gap:10rpx;font-size:30rpx}.rating-panel{display:flex;flex-direction:column;gap:28rpx}.rating-panel view{display:flex;align-items:center;justify-content:space-between;font-size:28rpx}.tag-list{display:flex;flex-wrap:wrap;gap:14rpx;margin-bottom:24rpx}.tag-list text{padding:12rpx 18rpx;border:1px solid #D7D0C8;border-radius:999rpx;background:#FBF8F5;color:#666A66;font-size:24rpx}.tag-list .selected{border-color:#3B533E;background:#E7ECE5;color:#3B533E}.tag-list .disabled,.options .disabled{opacity:.55}textarea{box-sizing:border-box;width:100%;min-height:180rpx;padding:20rpx;border:1px solid #D7D0C8;border-radius:16rpx;background:#FFFFFF;font-size:28rpx;line-height:40rpx}.count{display:block;margin-top:12rpx;text-align:right;color:#9A9B97;font-size:22rpx}.image-panel{display:flex;flex-direction:column;gap:22rpx}.image-panel-head{display:flex;flex-direction:column;gap:8rpx;font-size:28rpx}.image-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx}.image-item,.add-image{position:relative;aspect-ratio:1;border-radius:16rpx;overflow:hidden;background:#F3EEE8}.image-item image{width:100%;height:100%}.image-mask{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:12rpx;background:rgba(40,45,40,.55);color:#FFFFFF;font-size:22rpx;text-align:center}.image-mask.failed{background:rgba(194,91,82,.84)}.remove-image{position:absolute;right:8rpx;top:8rpx;display:flex;align-items:center;justify-content:center;width:36rpx;height:36rpx;border-radius:50%;background:rgba(24,28,24,.7);color:#FFFFFF;font-size:28rpx;line-height:36rpx}.add-image{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;border:1px dashed #C8BCAE;color:#3B533E;font-size:24rpx}.add-image text:first-child{font-size:42rpx;line-height:42rpx}.options{display:flex;flex-direction:column;gap:18rpx;color:#3B533E;font-size:26rpx}
