@import "../../styles/utilities.wxss";.qy-page{padding-bottom:calc(260rpx + env(safe-area-inset-bottom))}.mode-switch{display:flex;margin:0 32rpx;padding:6rpx;border-radius:16rpx;background:#E7ECE5}.mode-switch view{flex:1;padding:18rpx;text-align:center;color:#666A66;font-size:26rpx}.mode-switch .active{background:#FBF8F5;border-radius:12rpx;color:#3B533E;font-weight:500}.hint{margin:24rpx 32rpx;padding:20rpx;background:#F2E9DD;color:#705431;border-radius:12rpx;font-size:24rpx}.availability-filter{margin:22rpx 32rpx 0;text-align:right;color:#3B533E;font-size:24rpx}.state-card{padding:24rpx}.therapist-list{margin-top:28rpx}.therapist-card{display:flex;gap:20rpx;margin-bottom:20rpx;padding:24rpx;background:#FBF8F5;border:1px solid #D7D0C8;border-radius:16rpx}.therapist-card.selected{border:2rpx solid #3B533E}.therapist-card.unavailable{opacity:.64}.portrait{width:112rpx;height:132rpx;flex-shrink:0}.therapist-info{flex:1;display:flex;flex-direction:column;gap:9rpx}.level,.skill,.available-tag,.busy-tag{margin-left:14rpx;padding:5rpx 10rpx;border-radius:8rpx;background:#F2E9DD;color:#B28A57;font-size:20rpx}.available-tag{background:#E7ECE5;color:#3B533E}.busy-tag{background:#EEECE8;color:#9A9B97}.skill{margin-left:0;align-self:flex-start;background:#E7ECE5;color:#3B533E}.selected-mark{color:#fff;background:#3B533E;border-radius:50%;width:32rpx;height:32rpx;text-align:center}.bottom-summary{position:fixed;z-index:190;left:0;right:0;bottom:calc(136rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;gap:6rpx;padding:18rpx 32rpx;background:#F4F0EC;border-top:1px solid #E6DFD7;color:#666A66;font-size:22rpx}.bottom-summary text:last-child{color:#20231F;font-size:26rpx}
