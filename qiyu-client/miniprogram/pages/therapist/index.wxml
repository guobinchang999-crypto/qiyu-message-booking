<view class="qy-page"><qy-navbar title="{{dictionaries.pageTitle}}" /><view class="mode-switch"><view wx:for="{{dictionaries.modes}}" wx:key="key" class="{{mode === item.key ? 'active' : ''}}" data-mode="{{item.key}}" bindtap="chooseMode">{{item.label}}</view></view><view class="hint" wx:if="{{mode === 'auto'}}">{{dictionaries.autoHint}}</view><view wx:if="{{mode === 'specified'}}" class="availability-filter" bindtap="toggleUnavailable">{{showUnavailable ? stateCopy.unavailableFilterText : stateCopy.availableOnlyFilterText}}</view><view wx:if="{{loading}}" class="qy-section qy-card state-card"><qy-status-view type="loading" title="{{stateCopy.loadingTitle}}" description="{{stateCopy.loadingDescription}}" /></view><view wx:elif="{{error}}" class="qy-section qy-card state-card"><qy-status-view type="error" title="{{stateCopy.errorTitle}}" description="{{error}}" action-text="{{stateCopy.retryText}}" bind:retry="loadTherapists" /></view><view wx:elif="{{mode === 'specified' && visibleTherapists.length === 0}}" class="qy-section qy-card state-card"><qy-status-view type="empty" title="{{stateCopy.emptyTitle}}" description="{{stateCopy.emptyDescription}}" /></view><view class="qy-section therapist-list" wx:elif="{{mode === 'specified'}}"><view class="therapist-card {{selectedId === item.id ? 'selected' : ''}} {{item.availability !== 'available' ? 'unavailable' : ''}}" wx:for="{{visibleTherapists}}" wx:key="id" data-id="{{item.id}}" bindtap="selectTherapist"><view class="portrait"><qy-image src="{{item.avatarUrl}}" label="{{placeholderLabel}}" height="132rpx" radius="12rpx" /></view><view class="therapist-info"><view><text class="store-name">{{item.name}}</text><text class="level">{{item.level}}</text><text class="{{item.availability === 'available' ? 'available-tag' : 'busy-tag'}}">{{item.availabilityText}}</text></view><text class="qy-muted">{{item.metaText}}</text><text class="skill">{{item.skillText}}</text><text class="next">{{item.nextText}}</text></view><text class="selected-mark">{{selectedId === item.id ? '✓' : ''}}</text></view></view><view wx:if="{{!loading && !error}}" class="bottom-summary"><text>{{mode === 'auto' ? stateCopy.autoSummaryTitle : stateCopy.selectedSummaryTitle}}</text><text>{{selectedSummary}}</text></view><qy-bottom-action primary-text="{{stateCopy.nextButtonText}}" disabled="{{loading || !!error || (mode === 'specified' && !selectedId)}}" bind:primary="next" /></view>
