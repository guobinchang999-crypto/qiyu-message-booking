<view class="tabbar">
  <view
    class="tabbar-item {{selected === index ? 'active' : ''}}"
    wx:for="{{items}}"
    wx:key="path"
    data-index="{{index}}"
    data-path="{{item.path}}"
    aria-role="button"
    aria-label="{{item.text}}"
    aria-selected="{{selected === index}}"
    bindtap="onChange"
  >
    <text class="tabbar-icon">{{item.icon}}</text>
    <text class="tabbar-text">{{item.text}}</text>
  </view>
</view>
